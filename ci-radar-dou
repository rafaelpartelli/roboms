name: Radar DOU - Portarias MS

# TESTE: dispara tambem em push nesta branch, para validar o acesso ao INLABS
# a partir de um runner do GitHub sem precisar clicar em "Run workflow".
# Apos confirmar que o login funciona, remover o gatilho de push e manter so
# workflow_dispatch + schedule antes de mesclar para a main.
on:
  workflow_dispatch:
  push:
    branches: [ci-radar-dou]
  schedule:
    # Horarios provisorios (equivalentes a 08:30 e 11:00 em America/Sao_Paulo,
    # UTC-3). Ajustar depois de confirmar o horario real do cron da Hostinger.
    - cron: '30 11 * * 1-5'
    - cron: '0 14 * * 1-5'

jobs:
  radar-dou:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Instalar dependencias
        run: pip install -r robo_dou/requirements.txt

      - name: Rodar robo DOU (login INLABS + gerar radar.json)
        working-directory: robo_dou
        env:
          INLABS_EMAIL: ${{ secrets.INLABS_EMAIL }}
          INLABS_SENHA: ${{ secrets.INLABS_SENHA }}
        run: python3 robo_dou.py --days 1

      - name: Publicar radar.json no site (FTP/TLS)
        working-directory: robo_dou
        env:
          FTP_HOST: ${{ secrets.FTP_HOST }}
          FTP_USER: ${{ secrets.FTP_USER }}
          FTP_PASS: ${{ secrets.FTP_PASS }}
          FTP_DIR: ${{ secrets.FTP_DIR }}
          FTP_CERT_HOST: ${{ secrets.FTP_CERT_HOST }}
        run: bash publicar_radar.sh

      - name: Guardar radar.json gerado (artefato de depuracao)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: radar-json
          path: robo_dou/saida/radar.json
          if-no-files-found: ignore
